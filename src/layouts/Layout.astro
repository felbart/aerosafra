---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  import Lenis from "lenis";
  new Lenis({ autoRaf: true });
</script>
